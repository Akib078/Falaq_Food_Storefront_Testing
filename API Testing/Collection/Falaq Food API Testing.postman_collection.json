    {
      "name": "02 - Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order ID is present\", function () {\r",
                  "    pm.expect(response.orderId).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order number is present\", function () {\r",
                  "    pm.expect(response.orderNumber).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order number has expected format\", function () {\r",
                  "    pm.expect(response.orderNumber).to.match(/^ORD-\\d{8}-[A-Z0-9]+$/);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order total is a positive number\", function () {\r",
                  "    pm.expect(response.total).to.be.a(\"number\");\r",
                  "    pm.expect(response.total).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Placed time is present\", function () {\r",
                  "    pm.expect(response.placedAtUtc).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Account status is present\", function () {\r",
                  "    pm.expect(response.accountStatus).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// Save values for later tests\r",
                  "pm.collectionVariables.set(\"order_id\", response.orderId);\r",
                  "pm.collectionVariables.set(\"order_number\", response.orderNumber);\r",
                  "pm.collectionVariables.set(\"order_total\", response.total);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
