          "name": "Get Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Product ID is correct\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data.id).to.eql(\r",
                  "        \"019e44fc-a9b3-7a0b-ad14-39d717471c50\"\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Product is active\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data.status).to.eql(\"Active\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Product has at least one variant\", function () {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data.variants).to.be.an(\"array\").that.is.not.empty;\r",
                  "});"
                ],
